---
/**
 * Pagina Articole are două părți.
 *
 * Sus e blogul clientului de la Holo, pus pe 25 noiembrie 2026 la cererea lui:
 * scriptul aduce lista și deschide un articol pe aceeași pagină, la ?post=<slug>.
 * Codul e exact cel trimis de client. Scriptul își pune singur titlul,
 * descrierea și canonical-ul articolului deschis, deci pagina nu are canonical
 * propriu.
 *
 * Dedesubt e lista din src/content/articole. Pe fiecare limbă apar și
 * articolele scrise în altă limbă, netraduse, cu limba lor lângă dată.
 *
 * Până pe 20 noiembrie 2026, blogul clientului era la Soro (trysoro.com), tot cu
 * ?post=<slug>. Atunci am copiat articolele în src/content/articole/de, cu
 * aceleași adrese, și am scos scriptul. Linkurile vechi duc la pagina
 * articolului: pe domeniu prin public/.htaccess (301), iar scriptul de mai jos
 * acoperă restul. Ambele redirecționează doar adresele articolelor de pe site,
 * deci un ?post= de la Holo rămâne pe pagină.
 */
import { Picture } from 'astro:assets';
import Pagina from '../layouts/Pagina.astro';
import { type Limba } from '../i18n/limbi';
import { TEXT } from '../i18n/text';
import { adresa, articoleInLista, dataArticol, limbaArticol, linkArticol } from '../lib/articole';

interface Props {
  limba: Limba;
}

const { limba } = Astro.props;
const t = TEXT[limba].articole;
const lista = await articoleInLista(limba);
const postVechi = Object.fromEntries(lista.map((a) => [adresa(a), linkArticol(a)]));
---

<Pagina titlu={t.titlu} limba={limba} pagina="articole" descriere={t.descriere} canonic={false}>
  <script is:inline define:vars={{ postVechi }}>
    const post = new URLSearchParams(location.search).get('post');
    if (post && Object.hasOwn(postVechi, post)) location.replace(postVechi[post]);
  </script>

  <div class="cadru articole">
    <header>
      <h1>{t.h1}</h1>
      <p class="lead">{t.lead}</p>
    </header>

    <div id="holo-blog"></div>
    <script
      is:inline
      src="https://prod-api-holo-ai.fly.dev/public/seo/embed/ddfe89e9-b10a-4cb2-9e31-abc20d7a2088.js"
      defer></script>

    {
      lista.length > 0 && (
        <ol class="lista">
          {
            lista.map((a) => {
              const limbaA = limbaArticol(a);
              const strain = limbaA !== limba;
              return (
                <li class:list={{ 'cu-imagine': a.data.imagine }} lang={strain ? limbaA : undefined}>
                  {a.data.imagine && (
                    <a class="poza" href={linkArticol(a)} tabindex="-1" aria-hidden="true">
                      <Picture
                        src={a.data.imagine}
                        formats={['avif']}
                        fallbackFormat="webp"
                        widths={[336, 600, 900]}
                        sizes="(max-width: 600px) calc(100vw - 32px), 168px"
                        alt=""
                      />
                    </a>
                  )}
                  <div class="text">
                    <p class="meta" lang={limba}>
                      <time datetime={a.data.data.toISOString().slice(0, 10)}>{dataArticol(limba, a.data.data)}</time>
                      {strain && <span> · {t.inLimba[limbaA]}</span>}
                    </p>
                    <h2>
                      <a href={linkArticol(a)}>{a.data.titlu}</a>
                    </h2>
                    <p class="rezumat">{a.data.descriere}</p>
                  </div>
                </li>
              );
            })
          }
        </ol>
      )
    }
  </div>
</Pagina>

<style>
  .articole {
    max-width: calc(72ch + 2 * clamp(16px, 4vw, 32px));
    padding-top: clamp(32px, 6vw, 64px);
  }

  h1 {
    font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.5rem);
    margin-bottom: 14px;
  }

  .lead {
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  .lista {
    margin-top: clamp(24px, 4vw, 40px);
    border-top: 1px solid var(--color-ink);
  }

  li {
    padding: 20px 0 22px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .cu-imagine {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .poza {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-mic);
    background: var(--color-paper-2);
  }

  .poza :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  h2 {
    margin: 4px 0 8px;
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    line-height: 1.2;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 200ms ease-out;
  }

  h2 a:hover {
    background-size: 100% 1px;
  }

  .rezumat {
    max-width: 64ch;
    color: var(--color-ink-2);
  }

  /*
   * Articolele Holo vin ca HTML simplu, iar resetul din global.css le aplatizează
   * subtitlurile și listele. Aici primesc aceleași mărimi ca un articol de pe
   * site (Articol.astro). Primul h1 din text repetă titlul de deasupra, deci nu
   * se mai arată.
   */
  .articole :global(.holo-blog-article-content) {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .articole :global(.holo-blog-article-content > h1:first-child) {
    display: none;
  }

  .articole :global(.holo-blog-article-content :where(p, ul, ol, blockquote, table)) {
    margin-bottom: 1.1em;
  }

  .articole :global(.holo-blog-article-content h2) {
    margin: 1.8em 0 0.5em;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
    line-height: 1.2;
  }

  .articole :global(.holo-blog-article-content h3) {
    margin: 1.5em 0 0.4em;
    font-size: 1.3125rem;
    line-height: 1.25;
  }

  .articole :global(.holo-blog-article-content :where(ul, ol)) {
    padding-left: 1.3em;
  }

  .articole :global(.holo-blog-article-content ul) {
    list-style: disc;
  }

  .articole :global(.holo-blog-article-content ol) {
    list-style: decimal;
  }

  .articole :global(.holo-blog-article-content li + li) {
    margin-top: 0.35em;
  }

  .articole :global(.holo-blog-article-content a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .cu-imagine {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
