---
/**
 * Contact, după modelul trimis de client: datele de contact cu butoane pentru
 * WhatsApp, apel (pe numărul din Germania, cum a cerut) și email, apoi un
 * formular care pregătește mesajul. Formularul nu trimite nimic către site:
 * deschide WhatsApp sau programul de email, iar omul decide dacă trimite. Din
 * fișa unei parcele se ajunge aici cu ?cad=…, iar numărul intră singur în
 * formular (src/scripts/contact.ts).
 */
import Pagina from '../layouts/Pagina.astro';
import { CONTACT, mailto, telefonDeLink, telefonLink, whatsapp } from '../lib/contact';
import type { Limba } from '../i18n/limbi';
import { TEXT } from '../i18n/text';

interface Props {
  limba: Limba;
}

const { limba } = Astro.props;
const t = TEXT[limba].contact;
const lipsa = TEXT[limba].deCompletat;
const email = mailto();
---

<Pagina titlu={t.titlu} limba={limba} pagina="contact" descriere={t.descriere}>
  <section class="cadru intro">
    <h1>{t.h1}</h1>
    <p class="lead">{t.lead}</p>
  </section>

  <div class="cadru grila">
    <aside class="date" aria-labelledby="titlu-date">
      <h2 id="titlu-date">{t.dateTitlu}</h2>
      <dl class="fisa">
        <div>
          <dt>{t.telefon}</dt>
          <dd><a href={telefonLink}>{CONTACT.telefon}</a></dd>
        </div>
        <div>
          <dt>{t.telefonDe}</dt>
          <dd><a href={telefonDeLink}>{CONTACT.telefonDe}</a></dd>
        </div>
        <div>
          <dt>{t.whatsapp}</dt>
          <dd><a href={whatsapp()} rel="noopener">{CONTACT.telefon}</a></dd>
        </div>
        <div>
          <dt>{t.email}</dt>
          <dd>
            {
              CONTACT.email && email ? (
                <span class="email">
                  <a href={email}>{CONTACT.email}</a>
                  <button type="button" class="copiaza" data-copiaza={CONTACT.email}>
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                      <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" />
                    </svg>
                    <span aria-live="polite">{t.copiaza}</span>
                  </button>
                </span>
              ) : (
                <mark class="de-completat">
                  {lipsa}: {t.lipsaEmail}
                </mark>
              )
            }
          </dd>
        </div>
        <div>
          <dt>{t.vanzator}</dt>
          <dd>
            {
              CONTACT.nume ?? (
                <mark class="de-completat">
                  {lipsa}: {t.lipsaNume}
                </mark>
              )
            }
            {CONTACT.firma && <span class="firma">{CONTACT.firma}</span>}
          </dd>
        </div>
        {
          CONTACT.adresa && (
            <div>
              <dt>{t.adresa}</dt>
              <dd>{CONTACT.adresa}</dd>
            </div>
          )
        }
      </dl>

      <div class="actiuni">
        <a class="buton" href={whatsapp()} rel="noopener">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M10 2.75a7.25 7.25 0 0 0-6.3 10.83L2.75 17.25l3.75-.93A7.25 7.25 0 1 0 10 2.75Z" />
            <path d="M7.4 7.1c.2-.4.5-.4.7-.4h.4c.1 0 .3 0 .4.3l.6 1.4c0 .2 0 .3-.1.4l-.4.5c-.1.1-.1.3 0 .4.6 1 1.4 1.7 2.4 2.2.2.1.3 0 .4-.1l.5-.6c.1-.1.3-.2.4-.1l1.4.7c.2.1.3.2.3.4 0 .5-.2 1.1-.7 1.4-.5.3-1.2.4-2 .1-1.6-.6-3-1.8-3.9-3.3-.6-1-.8-2-.4-3.3Z" />
          </svg>
          {t.whatsapp}
        </a>
        <a class="buton buton-secundar" href={telefonDeLink} aria-label={t.sunaAria(CONTACT.telefonDe)}>
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M6.2 2.8 4.3 3.3c-.8.2-1.4 1-1.3 1.9.6 6 5.8 11.2 11.8 11.8.9.1 1.7-.5 1.9-1.3l.5-1.9a1 1 0 0 0-.6-1.2l-2.6-1a1 1 0 0 0-1.1.3l-1 1.2a10 10 0 0 1-4.4-4.4l1.2-1a1 1 0 0 0 .3-1.1l-1-2.6a1 1 0 0 0-1.2-.6Z" />
          </svg>
          {t.suna}
        </a>
        {
          email && (
            <a class="buton buton-secundar buton-lat" href={email}>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <rect x="2.75" y="4.75" width="14.5" height="10.5" rx="1.5" />
                <path d="m3.5 5.75 6.5 5 6.5-5" />
              </svg>
              {t.scrieEmail}
            </a>
          )
        }
      </div>
    </aside>

    <form
      id="form-mesaj"
      class="formular"
      data-wa={whatsapp()}
      data-email={email ?? undefined}
      aria-labelledby="titlu-form"
    >
      <h2 id="titlu-form">{t.formTitlu}</h2>
      <p class="form-lead">{t.formLead}</p>

      <label>
        <span class="eticheta">{t.nume}</span>
        <input name="nume" autocomplete="name" />
      </label>

      <label>
        <span class="eticheta">{t.cad} <span class="optional">({t.optional})</span></span>
        <input name="cad" class="mono" inputmode="numeric" autocomplete="off" spellcheck="false" />
      </label>

      <label>
        <span class="eticheta">{t.mesaj}</span>
        <textarea name="mesaj" rows="5" placeholder={t.mesajExemplu}></textarea>
      </label>

      <div class="form-butoane">
        <button type="submit" class="buton" value="whatsapp">{t.trimite}</button>
        {
          email && (
            <button type="submit" class="buton buton-secundar" value="email">
              {t.trimiteEmail}
            </button>
          )
        }
      </div>
      <p class="nota">{t.notaForm}</p>
    </form>
  </div>

  <script>
    import '../scripts/contact.ts';
  </script>
</Pagina>

<style>
  .intro {
    padding-block: clamp(32px, 6vw, 64px) 28px;
  }

  h1 {
    font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.5rem);
    margin-bottom: 14px;
  }

  .lead {
    max-width: 62ch;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  /* Datele de contact întâi, ca în modelul clientului; formularul lângă ele. */
  .grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    margin-bottom: 18px;
  }

  /* Datele de contact au forma unui extras: etichetă, valoare, hairline între rânduri. */
  .fisa {
    border-top: 1px solid var(--color-ink);
    font-size: 0.9375rem;
  }

  .fisa div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .fisa dt {
    color: var(--color-ink-2);
  }

  .fisa a {
    font-family: var(--font-mono);
    color: var(--color-ink);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--color-hairline);
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms ease-out;
  }

  .fisa a:hover {
    text-decoration-color: currentColor;
  }

  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .copiaza {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-mic);
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  .copiaza:hover {
    color: var(--color-ink);
    background: var(--color-paper-2);
  }

  .copiaza svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .firma {
    display: block;
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }

  /* WhatsApp și apelul pe un rând, emailul dedesubt pe toată lățimea. */
  .actiuni {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 22px;
  }

  .buton-lat {
    grid-column: 1 / -1;
  }

  .buton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-paper-3);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-panou);
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }

  .buton:hover {
    background: #000;
  }

  .buton-secundar {
    color: var(--color-ink);
    background: transparent;
    border-color: var(--color-hairline);
  }

  .buton-secundar:hover {
    background: var(--color-paper-2);
  }

  .buton svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .formular {
    display: grid;
    gap: 16px;
    padding: clamp(18px, 3vw, 28px);
    background: var(--color-paper-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
  }

  .formular h2 {
    margin-bottom: -8px;
  }

  .form-lead {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  label {
    display: grid;
    gap: 6px;
  }

  .eticheta {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .optional {
    font-weight: 400;
    color: var(--color-ink-3);
  }

  input,
  textarea {
    width: 100%;
    padding: 9px 11px;
    font-size: 1rem;
    background: #fff;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-mic);
    transition: border-color 150ms ease-out;
  }

  input:hover,
  textarea:hover {
    border-color: var(--color-ink-3);
  }

  .mono {
    font-family: var(--font-mono);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  textarea::placeholder {
    color: var(--color-ink-3);
  }

  .form-butoane {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .nota {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  @media (max-width: 860px) {
    .grila {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .fisa div {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .form-butoane .buton {
      flex: 1 1 100%;
    }
  }
</style>
