---
/**
 * Comuna și regiunea, pentru cine n-a mai fost pe acolo. Deschide descrierea
 * trimisă de client, apoi vin satele, Banatul și calupul. Textul, în cele trei
 * limbi, stă în src/i18n/zona.ts. Cifrele despre calup se calculează din date.
 */
import { Picture } from 'astro:assets';
import Pagina from '../layouts/Pagina.astro';
import { citesteCalup } from '../lib/date';
import { formatare } from '../lib/parcela';
import { ruta, type Limba } from '../i18n/limbi';
import { ZONA } from '../i18n/zona';
import hartaIosefina from '../assets/zona/harta-iosefina-sistarovat.jpg';
import pastor from '../assets/zona/pastor-valerio-1851.jpg';
import judet from '../assets/zona/judetul-arad-sistarovat.png';
import hartaGermaniBanat from '../assets/zona/harta-germani-banat.jpg';
import hartaGermaniAproape from '../assets/zona/harta-germani-langa-sistarovat.jpg';

interface Props {
  limba: Limba;
}

const { limba } = Astro.props;
const t = ZONA[limba];
const fmt = formatare(limba);

const parcele = citesteCalup('calup4').features.map((f) => f.properties);
const vanzare = parcele.filter((p) => p.vanzare);
const suprafata = (lista: typeof parcele) => lista.reduce((s, p) => s + p.suprafata, 0);

const categorii = [...Map.groupBy(vanzare, (p) => p.categorie)]
  .map(([c, lista]) => ({ nume: fmt.categorie(c), s: suprafata(lista) }))
  .sort((a, b) => b.s - a.s)
  .map((c) => `${fmt.ha(c.s)} ${t.categoriiMici ? c.nume.toLowerCase() : c.nume}`);

// Astro înghite spațiul dintre un rând de text și o expresie care începe pe
// rândul următor, deci fraza se compune întreagă, în zona.ts.
const d = t.descriereClient;
const g = t.germani;

const despreCalup = t.calup({
  total: fmt.parcele(parcele.length),
  ha: fmt.ha(suprafata(parcele)),
  vanzare: fmt.parcele(vanzare.length),
  haVanzare: fmt.ha(suprafata(vanzare)),
  categorii,
});
---

<Pagina titlu={t.titlu} limba={limba} pagina="zona" descriere={t.descriere}>
  <article>
    <header class="cadru deschidere">
      <div class="deschidere-text">
        <h1>{t.h1}</h1>
        <p class="lead">{t.lead}</p>
      </div>

      <dl class="fisa" aria-label={t.fisaAria}>
        {
          t.fisa.map(([cheie, val]) => (
            <div>
              <dt>{cheie}</dt>
              <dd>{val}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <figure class="cadru harta-veche">
      <Picture
        src={hartaIosefina}
        formats={['avif', 'webp']}
        widths={[800, 1200, 1600, 2400]}
        sizes="(max-width: 1160px) 100vw, 1096px"
        alt={t.hartaVecheAlt}
        loading="eager"
      />
      <figcaption>{t.hartaVeche}</figcaption>
    </figure>

    <div class="cadru bloc">
      <div class="descriere">
      <p class="descriere-intro">{d.intro}</p>
      {
        d.sectiuni.map((sec, i) => (
          <section aria-labelledby={`titlu-desc-${i}`}>
            <h2 id={`titlu-desc-${i}`}>{sec.titlu}</h2>
            {sec.intro && <p>{sec.intro}</p>}
            {sec.numerotat ? (
              <ol class="puncte numerotat">
                {sec.puncte.map(([eticheta, text]) => (
                  <li>
                    <strong>{eticheta}:</strong> {text}
                  </li>
                ))}
              </ol>
            ) : (
              <ul class="puncte">
                {sec.puncte.map(([eticheta, text]) => (
                  <li>
                    <strong>{eticheta}:</strong> {text}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      <p class="incheiere">{d.incheiere}</p>
      </div>
    </div>

    <section class="cadru bloc cu-imagine" aria-labelledby="titlu-istoric">
      <div class="text">
        <h2 id="titlu-istoric">{t.istoricTitlu}</h2>
        <p>{t.comuna}</p>
        {t.istoric.map((p) => <p>{p}</p>)}
      </div>
      <figure class="portret">
        <Picture
          src={pastor}
          formats={['avif', 'webp']}
          widths={[320, 436]}
          sizes="(max-width: 760px) 70vw, 320px"
          alt={t.pastorAlt}
        />
        <figcaption>{t.pastor}</figcaption>
      </figure>
    </section>

    <section class="cadru bloc cu-imagine cu-harta" aria-labelledby="titlu-banat">
      <div class="text">
        <h2 id="titlu-banat">{t.banatTitlu}</h2>
        {t.banat.map((p) => <p>{p}</p>)}
      </div>
      <figure class="judet">
        <Picture
          src={judet}
          formats={['avif', 'webp']}
          widths={[420, 840]}
          sizes="(max-width: 860px) 100vw, 420px"
          alt={t.judetAlt}
        />
        <figcaption>{t.judet}</figcaption>
      </figure>
    </section>

    <!-- Textul trimis de vânzător. Hărțile stau lângă partea pe care o arată:
         Banatul întreg lângă zone, vecinătatea satului lângă Șiștarovăț. -->
    <section class="cadru bloc germani" aria-labelledby="titlu-germani">
      <div class="text">
        <h2 id="titlu-germani">{g.titlu}</h2>
        <p>{g.intro}</p>
        <h3>{g.zoneTitlu}</h3>
        <p>{g.zoneIntro}</p>
      </div>

      <div class="cu-imagine cu-harta-germani">
        <div class="text">
          {
            g.zone.map((z) => (
              <section class="zona-germana">
                <h4>{z.titlu}</h4>
                <p>{z.intro}</p>
                <ul class="puncte">
                  {z.puncte.map(([loc, text]) => (
                    <li>
                      <strong>{loc}:</strong> {text}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        <figure class="harta-germani">
          <Picture
            src={hartaGermaniBanat}
            formats={['avif', 'webp']}
            widths={[400, 800, 984]}
            sizes="(max-width: 860px) 100vw, 420px"
            alt={g.hartaBanatAlt}
          />
          <figcaption>{g.hartaBanat}</figcaption>
        </figure>
      </div>

      <div class="cu-imagine cu-harta-germani">
        <div class="text">
          <h3>{g.sistarovatTitlu}</h3>
          {g.sistarovat.map((p) => <p>{p}</p>)}
        </div>
        <figure class="harta-germani">
          <Picture
            src={hartaGermaniAproape}
            formats={['avif', 'webp']}
            widths={[400, 800, 983]}
            sizes="(max-width: 860px) 100vw, 420px"
            alt={g.hartaAproapeAlt}
          />
          <figcaption>{g.hartaAproape}</figcaption>
        </figure>
      </div>
    </section>

    <section class="cadru bloc calup" aria-labelledby="titlu-calup">
      <div class="text">
        <h2 id="titlu-calup">{t.calupTitlu}</h2>
        <p>{despreCalup}</p>
        <div class="actiuni">
          <a class="buton" href={ruta('harta', limba)}>{t.butonHarta}</a>
          <a class="buton buton-secundar" href={`${ruta('parcele', limba)}?stare=vanzare`}>{t.butonLista}</a>
        </div>
      </div>
    </section>

    <p class="cadru surse">{t.surse}</p>
  </article>
</Pagina>

<style>
  .deschidere {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding-block: clamp(32px, 6vw, 72px) clamp(28px, 4vw, 44px);
  }

  h1 {
    font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.5rem);
    margin-bottom: 18px;
  }

  .lead {
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  /* Fișa are forma unui extras: etichetă la stânga, valoare la dreapta, hairline între rânduri. */
  .fisa {
    border-top: 1px solid var(--color-ink);
    font-size: 0.875rem;
  }

  .fisa div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .fisa dt {
    color: var(--color-ink-2);
  }

  .harta-veche :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2400 / 1433;
    border-radius: var(--radius-panou);
    border: 1px solid var(--color-hairline);
  }

  figcaption {
    margin-top: 10px;
    max-width: 72ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .bloc {
    padding-top: clamp(40px, 6vw, 72px);
  }

  .text {
    max-width: 64ch;
  }

  h2 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    margin-bottom: 14px;
  }

  .text p + p {
    margin-top: 14px;
  }

  /* Descrierea clientului: secțiuni scurte, cu punctele „Etichetă: text”. */
  .descriere {
    max-width: 68ch;
  }

  .descriere-intro {
    font-size: 1.0625rem;
  }

  .descriere section {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
  }

  .descriere h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    margin-bottom: 10px;
  }

  .puncte {
    display: grid;
    gap: 10px;
    margin-top: 12px;
    padding-left: 1.1em;
    list-style: disc;
  }

  .puncte.numerotat {
    list-style: decimal;
  }

  .puncte li::marker {
    color: var(--color-ink-3);
  }

  .puncte strong {
    font-weight: 600;
  }

  .incheiere {
    margin-top: 32px;
    padding: 16px 18px;
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem);
    line-height: 1.5;
    background: var(--color-paper-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
  }

  .cu-imagine {
    display: grid;
    grid-template-columns: minmax(0, 64ch) 320px;
    justify-content: space-between;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .cu-harta {
    grid-template-columns: minmax(0, 64ch) 420px;
    align-items: center;
  }

  .judet :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1432 / 821;
  }

  .portret :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 436 / 640;
    border-radius: var(--radius-mic);
  }

  /* Istoria germanilor: textul la stânga, harta la dreapta, care rămâne în ecran cât se citesc zonele. */
  .germani h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    margin: 28px 0 10px;
  }

  .germani h4 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem);
    line-height: 1.25;
    margin-bottom: 8px;
  }

  .cu-harta-germani {
    grid-template-columns: minmax(0, 64ch) 420px;
    margin-top: 28px;
  }

  .zona-germana + .zona-germana {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
  }

  .harta-germani {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .harta-germani :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-panou);
  }

  .calup .text {
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
    max-width: none;
  }

  .calup p {
    max-width: 64ch;
  }

  .actiuni {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .buton {
    display: inline-block;
    padding: 11px 18px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-paper-3);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-panou);
    text-decoration: none;
    transition: background-color 150ms ease-out;
  }

  .buton:hover {
    background: #000;
  }

  .buton-secundar {
    color: var(--color-ink);
    background: transparent;
    border-color: var(--color-hairline);
  }

  .buton-secundar:hover {
    background: var(--color-paper-2);
  }

  .surse {
    margin-top: clamp(40px, 6vw, 64px);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  @media (max-width: 860px) {
    .deschidere {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .cu-imagine {
      grid-template-columns: 1fr;
    }

    .portret {
      max-width: 280px;
    }

    .harta-germani {
      position: static;
      max-width: 480px;
    }
  }
</style>
