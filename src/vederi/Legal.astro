---
/** Confidențialitate, termeni, cookies. Textul vine din src/i18n/legal.ts. */
import Pagina from '../layouts/Pagina.astro';
import { LEGAL, type PaginaLegala } from '../i18n/legal';
import type { Limba } from '../i18n/limbi';
import { MARCA } from '../i18n/text';

interface Props {
  limba: Limba;
  pagina: PaginaLegala;
}

const { limba, pagina } = Astro.props;
const doc = LEGAL[pagina](limba);
---

<Pagina titlu={`${doc.titlu} · ${MARCA}`} limba={limba} pagina={pagina} descriere={doc.descriere}>
  <article class="cadru legal">
    <header>
      <h1>{doc.titlu}</h1>
      <p class="actualizat">{doc.actualizat}</p>
      {doc.intro && <p class="lead">{doc.intro}</p>}
    </header>

    {
      doc.sectiuni.map((s, i) => (
        <section>
          <h2>
            <span class="nr">{i + 1}.</span> {s.titlu}
          </h2>
          <Fragment set:html={s.html} />
        </section>
      ))
    }
  </article>
</Pagina>

<style>
  .legal {
    max-width: calc(68ch + 2 * clamp(16px, 4vw, 32px));
    padding-top: clamp(32px, 6vw, 64px);
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: 10px;
  }

  .actualizat {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  .lead {
    margin-top: 20px;
    padding: 14px 16px;
    font-size: 1.0625rem;
    line-height: 1.6;
    background: var(--color-paper-3);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
  }

  section {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
  }

  h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    margin-bottom: 12px;
  }

  .nr {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--color-ink-3);
  }

  section :global(p + p),
  section :global(ul + p),
  section :global(p + ul) {
    margin-top: 12px;
  }

  section :global(ul) {
    display: grid;
    gap: 8px;
    padding-left: 1.1em;
    list-style: disc;
  }

  section :global(li::marker) {
    color: var(--color-ink-3);
  }

  section :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-ink-3);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease-out;
  }

  section :global(a:hover) {
    text-decoration-color: currentColor;
  }

  section :global(strong) {
    font-weight: 600;
  }
</style>
