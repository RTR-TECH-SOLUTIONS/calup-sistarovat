---
/**
 * Antetul, pe toate paginile, cum l-a cerut clientul: sigla stânga sus, lângă
 * ea „Grundstücke Banat Rumänien”, apoi limbile DE EN RO și meniul. Numele e
 * text, nu imagine, așezat pe trei rânduri ca în sigla primită.
 */
import Sigla from './Sigla.astro';
import Navigatie from './Navigatie.astro';
import Limbi from './Limbi.astro';
import { ruta, type Limba, type Pagina } from '../i18n/limbi';
import { TEXT } from '../i18n/text';

interface Props {
  limba: Limba;
  pagina: Pagina;
  /** Pe hartă antetul ține toată lățimea; pe paginile cu text stă în cadru. */
  lat?: boolean;
  /** Adresele aceleiași pagini în celelalte limbi, când nu sunt cele din RUTE (articolele). */
  adrese?: Partial<Record<Limba, string>>;
}

const { limba, pagina, lat = false, adrese } = Astro.props;
const t = TEXT[limba];
---

<header class:list={['antet', { 'antet-lat': lat }]}>
  <div class:list={['antet-rand', { cadru: !lat }]}>
    <a class="marca" href={ruta('harta', limba)}>
      <Sigla class="marca-semn" />
      <span class="marca-text">
        <span class="marca-r1">Grundstücke</span>
        <span class="marca-r1">Banat</span>
        <span class="marca-r2">Rumänien</span>
      </span>
    </a>

    <Navigatie limba={limba} curent={pagina} />

    <div class="antet-dreapta">
      <Limbi limba={limba} pagina={pagina} adrese={adrese} />
      <button type="button" class="buton-meniu" popovertarget="meniu" aria-label={t.nav.meniu}>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .antet {
    position: relative;
    z-index: 20;
    height: var(--header-h);
    background: var(--color-paper-3);
    border-bottom: 1px solid var(--color-hairline);
  }

  .antet-lat .antet-rand {
    padding-inline: 16px;
  }

  .antet-rand {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--color-marca);
    text-decoration: none;
  }

  .marca :global(.marca-semn) {
    flex: none;
    width: auto;
    height: 40px;
  }

  /* Ca în siglă: primele două rânduri groase, al treilea mic, rărit, cu linia aurie dedesubt. */
  .marca-text {
    display: grid;
    justify-items: start;
    font-family: var(--font-marca);
    text-transform: uppercase;
    line-height: 1;
  }

  .marca-r1 {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .marca-r2 {
    margin-top: 2px;
    padding-bottom: 3px;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    background: linear-gradient(
        90deg,
        transparent,
        var(--color-marca-aur) 18%,
        var(--color-marca-aur) 82%,
        transparent
      )
      bottom / 100% 1.5px no-repeat;
  }

  .antet-dreapta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .buton-meniu {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--color-ink);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
    transition: background-color 150ms ease-out;
  }

  .buton-meniu:hover {
    background: var(--color-paper-2);
  }

  .buton-meniu svg {
    width: 20px;
    height: 20px;
  }

  @media (min-width: 960px) {
    .buton-meniu {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .marca :global(.marca-semn) {
      height: 46px;
    }

    .marca-r1 {
      font-size: 1rem;
    }

    .marca-r2 {
      font-size: 0.625rem;
    }
  }

  @media (max-width: 380px) {
    .antet-rand {
      gap: 12px;
    }

    .marca {
      gap: 8px;
    }

    .marca :global(.marca-semn) {
      height: 34px;
    }

    .marca-r1 {
      font-size: 0.8125rem;
    }

    /* La 320px (iPhone SE) totul încape doar dacă limbile și meniul se strâng puțin. */
    .antet-dreapta {
      gap: 6px;
    }

    .antet-dreapta :global(.limbi a) {
      padding-inline: 4px;
    }

    .buton-meniu {
      width: 36px;
      height: 36px;
    }
  }
</style>
