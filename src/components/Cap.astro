---
/**
 * Partea comună din <head>. Fonturile le descarcă Astro la build și le servește
 * de pe același server cu site-ul: vizitatorul nu ajunge la Google, deci nu
 * trebuie trecut în politica de confidențialitate și nu cere consimțământ.
 */
import { Font } from 'astro:assets';
import { cale } from '../lib/cale';
import { LIMBI, ruta, type Limba, type Pagina } from '../i18n/limbi';

interface Props {
  titlu: string;
  descriere?: string;
  limba: Limba;
  pagina: Pagina;
  /** Adresele aceleiași pagini în celelalte limbi, când nu sunt cele din RUTE (articolele). */
  adrese?: Partial<Record<Limba, string>>;
}

const { titlu, descriere, pagina, adrese } = Astro.props;
// hreflang doar spre traducerile care există.
const alternative = adrese ? LIMBI.filter((l) => adrese[l]) : LIMBI;
const absolut = (l: Limba) => new URL(adrese?.[l] ?? ruta(pagina, l), Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titlu}</title>
{descriere && <meta name="description" content={descriere} />}
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" href={cale('/favicon.svg')} type="image/svg+xml" />
{alternative.map((l) => <link rel="alternate" hreflang={l} href={absolut(l)} />)}
<link rel="alternate" hreflang="x-default" href={absolut(alternative.includes('ro') ? 'ro' : alternative[0])} />
<Font cssVariable="--font-plex-sans" preload={[{ weight: 400, subset: 'latin' }]} />
<Font cssVariable="--font-plex-mono" />
<Font cssVariable="--font-newsreader" />
<Font cssVariable="--font-montserrat" preload={[{ weight: 700, subset: 'latin' }]} />
