---
import { ruta, type Limba, type Pagina } from '../i18n/limbi';
import { TEXT } from '../i18n/text';

type Sectiune = 'harta' | 'parcele' | 'zona' | 'contact';

interface Props {
  limba: Limba;
  /** Paginile legale nu sunt în navigație, deci nu marchează nimic. */
  curent: Pagina;
}

const { limba, curent } = Astro.props;
const t = TEXT[limba].nav;
const sectiuni: Sectiune[] = ['harta', 'parcele', 'zona', 'contact'];
---

<nav class="navigatie" aria-label={t.aria}>
  <ul>
    {
      sectiuni.map((s) => (
        <li>
          <a href={ruta(s, limba)} aria-current={s === curent ? 'page' : undefined}>
            {t[s]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    gap: 18px;
  }

  a {
    display: block;
    padding: 10px 0 8px;
    font-size: 0.875rem;
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  a:hover {
    color: var(--color-ink);
  }

  a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 500;
    border-bottom-color: var(--color-ink);
  }
</style>
