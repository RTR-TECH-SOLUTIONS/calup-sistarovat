---
/**
 * DE · EN · RO. Fiecare duce la aceeași pagină în cealaltă limbă. Un articol
 * fără traducere trimite la lista de articole din limba aleasă.
 */
import { NUME_LIMBA, ORDINE_LIMBI, ruta, type Limba, type Pagina } from '../i18n/limbi';
import { TEXT } from '../i18n/text';

interface Props {
  limba: Limba;
  pagina: Pagina;
  /** Adresele aceleiași pagini în celelalte limbi, când nu sunt cele din RUTE (articolele). */
  adrese?: Partial<Record<Limba, string>>;
}

const { limba, pagina, adrese } = Astro.props;
---

<nav class="limbi" aria-label={TEXT[limba].limbiAria}>
  {
    ORDINE_LIMBI.map((l) => (
      <a
        href={adrese?.[l] ?? ruta(pagina, l)}
        hreflang={l}
        lang={l}
        aria-label={NUME_LIMBA[l]}
        aria-current={l === limba ? 'true' : undefined}
        data-limba
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</nav>

<script>
  // Parcela deschisă pe hartă (?cad=) și filtrele din listă stau în adresă;
  // la schimbarea limbii rămân aceleași.
  document.querySelectorAll<HTMLAnchorElement>('a[data-limba]').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.search) a.href = a.href.split('?')[0] + location.search;
    });
  });
</script>

<style>
  .limbi {
    display: flex;
    gap: 2px;
  }

  a {
    padding: 4px 6px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-ink-3);
    text-decoration: none;
    border-radius: var(--radius-mic);
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  a:hover {
    color: var(--color-ink);
    background: var(--color-paper-2);
  }

  a[aria-current='true'] {
    color: var(--color-ink);
    background: var(--color-paper-2);
  }
</style>
