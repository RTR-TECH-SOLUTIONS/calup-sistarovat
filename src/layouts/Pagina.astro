---
/** Paginile cu text (despre, lista, zona, FAQ, contact, legale). Harta are ecranul ei, cu același antet. */
import '../styles/global.css';
import Cap from '../components/Cap.astro';
import Antet from '../components/Antet.astro';
import Legale from '../components/Legale.astro';
import type { Limba, Pagina } from '../i18n/limbi';
import { TEXT } from '../i18n/text';

interface Props {
  titlu: string;
  limba: Limba;
  pagina: Pagina;
  descriere?: string;
  /** Adresele aceleiași pagini în celelalte limbi, când nu sunt cele din RUTE (articolele). */
  adrese?: Partial<Record<Limba, string>>;
}

const { titlu, limba, pagina, descriere, adrese } = Astro.props;
const t = TEXT[limba];
---

<!doctype html>
<html lang={limba}>
  <head>
    <Cap titlu={titlu} descriere={descriere} limba={limba} pagina={pagina} adrese={adrese} />
  </head>
  <body>
    <Antet limba={limba} pagina={pagina} adrese={adrese} />

    <main>
      <slot />
    </main>

    <footer class="subsol">
      <div class="cadru">
        <Legale limba={limba} curent={pagina} />
        <p class="subsol-nota">{t.previzualizare}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .cadru {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }
</style>

<style>
  .subsol {
    margin-top: clamp(48px, 8vw, 96px);
    padding-block: 20px 28px;
    border-top: 1px solid var(--color-hairline);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }

  .subsol-nota {
    margin-top: 12px;
    color: var(--color-ink-3);
  }
</style>
